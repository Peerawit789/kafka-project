# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_COMMANDS=router-commands
KAFKA_TOPIC_RESULTS=router-results
KAFKA_TOPIC_DLQ=router-dlq
KAFKA_GROUP_ID=router-workers

# Router Credentials (Must match GNS3 Cisco configuration)
ROUTER_USER=admin
ROUTER_PASS=cisco123
ROUTER_ENABLE_PASS=cisco123

# Worker SSH Timeout Configuration (seconds)
SSH_CONNECT_TIMEOUT=8
SSH_READ_TIMEOUT=15
SSH_MAX_RETRIES=3
